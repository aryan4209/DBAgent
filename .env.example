# --- AI model (free) ---
# Any OpenAI-compatible endpoint. Defaults: local Ollama + its free cloud model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=nemotron-3-ultra:cloud
# Ollama ignores this. Set it for Groq / Gemini / OpenRouter.
LLM_API_KEY=

# Other free options (uncomment one set):
# Fully local and private (small model, slower on 8 GB RAM):
#   LLM_MODEL=qwen3:4b            (first run: ollama pull qwen3:4b)
# Groq (free key: console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# Google Gemini (free key: aistudio.google.com):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash

# --- SQL Server ---
# Use a login that has ONLY db_datareader (see sql/create-readonly-login.sql).
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
# true = ApplicationIntent=ReadOnly (routes to a readable AG secondary if one exists)
MSSQL_READONLY_INTENT=false

# --- Agent limits ---
AGENT_MAX_ROWS=200
AGENT_QUERY_TIMEOUT_MS=30000
